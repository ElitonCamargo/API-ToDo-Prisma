generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senha     String
  avatar    String?
  createAt  DateTime @default(now())
  updateAt  DateTime @updatedAt

  tarefas   Tarefa[]
}

model Tarefa {
  id        Int      @id @default(autoincrement())
  titulo    String
  descricao String
  data      DateTime
  status    String

  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])

  createAt  DateTime @default(now())
  updateAt  DateTime @updatedAt
}

